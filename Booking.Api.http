@baseUrl = https://localhost:7214
@accessToken = paste-access-token-here

### Log in as the seeded Admin user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "replace-with-your-admin-password"
}

### Call an authenticated API endpoint
GET {{baseUrl}}/bookings/confirmed
Authorization: Bearer {{accessToken}}
